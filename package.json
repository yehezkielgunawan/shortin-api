{
	"name": "shortin-api-v2",
	"version": "1.0.0",
	"description": "This is the updated version of previous shortin project. It is a URL shortener that uses Google APIs to shorten URLs and store them in a database.",
	"private": true,
	"scripts": {
		"check": "pnpm cloudflare:build && pnpm exec biome check . && pnpm test && pnpm exec wrangler deploy --dry-run",
		"dev": "wrangler dev --local --env-file .dev.vars",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"up-latest": "pnpm up -i -L",
		"cloudflare:build": "tsc --noEmit",
		"cloudflare:preview": "pnpm dev",
		"cloudflare:deploy": "pnpm cloudflare:build && wrangler deploy",
		"smoke:local": "node --env-file=.dev.vars test-api.js",
		"cleanup:preview": "node --experimental-strip-types scripts/preview-link-cleanup.mjs",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"packageManager": "pnpm@10.15.1+sha512.34e538c329b5553014ca8e8f4535997f96180a1d0f614339357449935350d924e22f8614682191264ec33d1462ac21561aff97f6bb18065351c162c7e8f6de67",
	"dependencies": {
		"googleapis": "^170.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.11",
		"@cloudflare/workers-types": "^4.20260115.0",
		"@types/node": "^25.0.8",
		"@vitest/coverage-v8": "4.0.17",
		"typescript": "^5.9.3",
		"vitest": "^4.0.17",
		"wrangler": "^4.59.2"
	}
}

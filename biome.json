{
	"$schema": "https://biomejs.dev/schemas/2.3.11/schema.json",
	"files": {
		"ignoreUnknown": false
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": {
					"level": "on"
				}
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"nursery": {
				"useSortedClasses": {
					"level": "warn",
					"options": {
						"attributes": ["classList"],
						"functions": ["tw", "clsx", "cva"]
					},
					"fix": "safe"
				}
			},
			"correctness": {
				"noUnusedImports": {
					"level": "error",
					"fix": "safe"
				},
				"noUnusedVariables": {
					"level": "warn",
					"fix": "none"
				},
				"noUnusedFunctionParameters": {
					"level": "off"
				}
			},
			"suspicious": {
				"noExplicitAny": {
					"level": "off"
				}
			},
			"style": {
				"noUselessElse": {
					"level": "warn",
					"fix": "safe"
				},
				"useConst": {
					"level": "warn",
					"fix": "safe"
				}
			}
		}
	},
	"formatter": {
		"enabled": true,
		"lineEnding": "lf",
		"indentStyle": "tab",
		"indentWidth": 2
	},
	"javascript": {
		"formatter": {
			"arrowParentheses": "always",
			"bracketSpacing": true,
			"trailingCommas": "all",
			"jsxQuoteStyle": "double",
			"semicolons": "always"
		}
	},
	"css": {
		"formatter": {
			"enabled": true
		}
	},
	"overrides": [
		{
			"includes": ["cloudflare-env.d.ts"],
			"linter": {
				"enabled": false
			}
		},
		{
			"includes": ["coverage/**"],
			"linter": {
				"enabled": false
			},
			"formatter": {
				"enabled": false
			}
		},
		{
			"includes": ["dist/**"],
			"linter": {
				"enabled": false
			},
			"formatter": {
				"enabled": false
			}
		},
		{
			"includes": ["dist-worker/**"],
			"linter": {
				"enabled": false
			},
			"formatter": {
				"enabled": false
			}
		},
		{
			"includes": ["test/**"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedVariables": {
							"level": "off"
						}
					}
				}
			}
		}
	]
}
